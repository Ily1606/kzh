APP_NAME=DSH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dsh
DB_USERNAME=dsh
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

VITE_APP_NAME="${APP_NAME}"

# Plugins Configuration
PLUGIN_VIEW_CACHE_TTL=86400
PLUGIN_DEFAULT_PER_PAGE=15
PLUGIN_MAX_PER_PAGE=100

# Trending Algorithm & API Limits
PLUGIN_TRENDING_DEFAULT_LIMIT=15
PLUGIN_TRENDING_MAX_LIMIT=50
PLUGIN_TRENDING_CACHE_TTL=300
PLUGIN_TRENDING_DAYS_LIMIT=30
PLUGIN_TRENDING_WEIGHT_VIEW=1
PLUGIN_TRENDING_WEIGHT_COMMENT=5
PLUGIN_TRENDING_WEIGHT_STAR=10
PLUGIN_TRENDING_GRAVITY=1.8
PLUGIN_TRENDING_AGE_OFFSET=2

# Auth API Rate Limiting Quotas (per minute)
AUTH_LIMITER_REGISTER_PER_EMAIL=5
AUTH_LIMITER_REGISTER_PER_ACCOUNT=30
AUTH_LIMITER_REGISTER_PER_IP=20
AUTH_LIMITER_LOGIN_PER_EMAIL=5
AUTH_LIMITER_LOGIN_PER_ACCOUNT=30
AUTH_LIMITER_LOGIN_PER_IP=20
AUTH_LIMITER_PASSWORD_RESET_LINK_PER_EMAIL=3
AUTH_LIMITER_PASSWORD_RESET_LINK_PER_ACCOUNT=10
AUTH_LIMITER_PASSWORD_RESET_LINK_PER_IP=10
AUTH_LIMITER_PASSWORD_RESET_PER_EMAIL=3
AUTH_LIMITER_PASSWORD_RESET_PER_ACCOUNT=10
AUTH_LIMITER_PASSWORD_RESET_PER_IP=10

# General API Rate Limiting Quotas (per minute)
API_RATE_LIMIT=60
API_STRICT_RATE_LIMIT=5
