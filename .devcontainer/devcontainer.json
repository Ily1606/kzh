{
  "name": "dsh monorepo",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "Vue.volar",
        "ms-azuretools.vscode-docker",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "forwardPorts": [8000, 5173, 5432, 6379, 8025],
  "postCreateCommand": "composer --version && node --version && pnpm --version"
}
